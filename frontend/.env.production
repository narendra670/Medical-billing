# Production backend URL - Set this to your deployed backend URL
# Examples:
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_URL=https://backend-service.herokuapp.com
# VITE_API_URL=https://your-azure-app.azurewebsites.net

# If not set, defaults to window.location.origin (current domain)
# This works when frontend and backend are on the same domain
VITE_API_URL=